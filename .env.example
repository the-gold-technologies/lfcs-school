# Content management system (lfcs-school-cms). Without CMS_URL the site renders the bundled
# snapshot in src/content/cms-snapshot.json.
CMS_URL="http://localhost:3001"
# Must match CMS_SHARED_SECRET in the CMS: authorises cache refreshes and enquiry forwarding
CMS_SHARED_SECRET=""

# Public address of this website, used for canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_URL="https://lfgos.com"

# Enquiry emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
FRANCHISE_TO_EMAIL="franchise@lfcsschools.com"
